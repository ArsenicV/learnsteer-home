---
import Base from '../layouts/Base.astro';
import SiteEffects from '../components/effects/SiteEffects';
import { C } from '../lib/content';

const nav = C.nav;
---
<Base title={`${C.brand} — Contributors`}>
  <header class="site-header">
    <a href="/" class="brand" aria-label="LearnSteer 2.0"><span class="lbl">Non-profit</span><small class="lbl">since 2024</small></a>
    <a href="/" class="logo" aria-label="Home">/</a>
    <div class="hdr-r">
      <nav class="d" id="nav" aria-label="Primary">
        {nav.map((n) => <a href={n === 'Contact' ? '/#join' : n === 'Services' ? '/#svc' : '/'}>{n}</a>)}
      </nav>
      <a class="btn" href="/#join">Contact</a>
      <button class="burger" id="bg" aria-expanded="false" aria-controls="ov">Menu</button>
    </div>
  </header>
  <div id="ov" role="dialog" aria-label="Menu">
    <button class="burger x" id="bx">Close</button>
    {nav.map((n, i) => <a href={n === 'Contact' ? '/#join' : n === 'Services' ? '/#svc' : '/'} style={`transition-delay:${0.1 + i * 0.07}s`}>{n}</a>)}
  </div>

  <main class="wrap" style="padding-top:112px;padding-bottom:80px;min-height:100svh">
    <div class="vh"><a class="lk lbl" href="/">&larr; Home</a><span class="lbl" id="cn">0 contributors</span></div>
    <h2 class="big" style="font-size:clamp(32px,5vw,72px);margin:0">Contributors</h2>
    <div class="tools">
      <input id="q" type="search" placeholder="Search by name" aria-label="Search contributors by name" />
      <div id="chips" class="tools" style="margin:0" role="group" aria-label="Filter by team"></div>
      <button class="sm" id="lv" aria-pressed="false">List view</button>
    </div>
    <div class="gw" id="gw"><canvas id="gc" role="img" aria-label="Network graph of contributors. Use list view for a keyboard-friendly version."></canvas></div>
    <ul class="gl" id="gl" hidden></ul>
    <aside id="gcard" hidden aria-label="Contributor details"></aside>
  </main>



  <footer style="background:var(--sky);color:#fff;text-align:center;padding:20px 16px;font-size:14px;">
    <p style="margin:0;"><strong>LearnSteer 2.0</strong> &nbsp;·&nbsp; &copy; {new Date().getFullYear()} LearnSteer 2.0. All rights reserved.</p>
  </footer>

  <SiteEffects client:load />
</Base>

<script>
  const ov = document.getElementById('ov');
  const bg = document.getElementById('bg');
  const bx = document.getElementById('bx');
  const tog = (o: boolean) => {
    ov?.classList.toggle('open', o);
    bg?.setAttribute('aria-expanded', String(o));
    if (o) (bx as HTMLButtonElement | null)?.focus();
  };
  bg?.addEventListener('click', () => tog(true));
  bx?.addEventListener('click', () => tog(false));
  ov?.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName === 'A') tog(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') { tog(false); if (typeof (window as any).__closeCard === 'function') (window as any).__closeCard(); } });
</script>

<script>
  import { supabase, publicUrl } from '../lib/supabaseClient';
  import { PLACEHOLDER_CONTRIBUTORS } from '../lib/content';

  const $ = (s: string) => document.querySelector(s) as HTMLElement | null;
  const esc = (s: any) => String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'} as any)[c]);
  const ini = (n: string) => n.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
  const RM = matchMedia('(prefers-reduced-motion:reduce)').matches;

  let contributors = [...PLACEHOLDER_CONTRIBUTORS];
  let G: any = null, cam = { x: 0, y: 0, k: 1 }, hv: any = null, sel: any = null, dirty = true, raf = 0, fq = '', ft = '', TT = 0, lvOn = false;

  const cvs = $('#gc') as HTMLCanvasElement;
  const gx = cvs.getContext('2d')!;
  const matchNode = (n: any) => (!ft || n.p.team === ft) && (!fq || (n.p.name || '').toLowerCase().includes(fq));

  function buildGraph(list: any[]) {
    const n = list.length;
    const teams = [...new Set(list.map(p => p.team || '-'))];
    const nodes = list.map((p, i) => {
      const t = teams.indexOf(p.team || '-');
      const a = t / Math.max(1, teams.length) * Math.PI * 2;
      return { p, i, t, x: Math.cos(a) * 220 + Math.cos(i * 2.4) * 70, y: Math.sin(a) * 220 + Math.sin(i * 2.4) * 70, vx: 0, vy: 0, ph: i * 1.7 };
    });
    const edges: any[] = [];
    const has = (a: any, b: any) => edges.some(e => (e[0] === a && e[1] === b) || (e[0] === b && e[1] === a));
    teams.forEach((_, t) => {
      const g = nodes.filter(x => x.t === t);
      g.forEach((a, k) => [1, 3].forEach(s => { const b = g[(k + s) % g.length]; if (b && b !== a && !has(a, b)) edges.push([a, b]); }));
    });
    for (let k = 0; k < Math.ceil(n / 6); k++) { const a = nodes[(k * 7) % n], b = nodes[(k * 11 + 3) % n]; if (a && b && a.t !== b.t && !has(a, b)) edges.push([a, b]); }
    for (let it = 0; it < 400; it++) {
      const c = 1 - it / 400;
      for (const a of nodes) { for (const b of nodes) { if (a === b) continue; const dx = a.x - b.x, dy = a.y - b.y, d = Math.sqrt(dx*dx+dy*dy)+.1, f = 2600/(d*d); a.vx += dx/d*f; a.vy += dy/d*f; } a.vx -= a.x*.002; a.vy -= a.y*.002; }
      for (const [a,b] of edges) { const dx = b.x-a.x, dy = b.y-a.y, d = Math.hypot(dx,dy)||1, k=(d-70)*.02; a.vx+=dx/d*k; a.vy+=dy/d*k; b.vx-=dx/d*k; b.vy-=dy/d*k; }
      for (const a of nodes) { a.x += a.vx*c*.6; a.y += a.vy*c*.6; a.vx*=.8; a.vy*=.8; }
    }
    return { nodes, edges, teams };
  }

  function gsize() {
    if (!G) return;
    const r = cvs.getBoundingClientRect();
    const d = Math.min(devicePixelRatio || 1, 2);
    cvs.width = Math.max(1, r.width * d); cvs.height = Math.max(1, r.height * d);
    G.d = d; G.w = r.width; G.h = r.height; dirty = true;
  }
  const w2s = (n: any): [number, number] => [G.w/2 + n.x*cam.k + cam.x + Math.sin(TT*.5+n.ph)*1.6, G.h/2 + n.y*cam.k + cam.y + Math.cos(TT*.4+n.ph)*1.6];

  function gdraw() {
    gx.setTransform(G.d, 0, 0, G.d, 0, 0);
    gx.clearRect(0, 0, G.w, G.h);
    const act = hv || sel; const nb = new Set<any>();
    if (act) { nb.add(act); G.edges.forEach(([a,b]: any) => { if (a===act) nb.add(b); if (b===act) nb.add(a); }); }
    for (const [a,b] of G.edges) {
      const on = act && (a===act||b===act); const p = w2s(a), q = w2s(b);
      const alpha = on ? 0.55 : act ? 0.05 : (matchNode(a) && matchNode(b) ? 0.18 : 0.05);
      gx.strokeStyle = `rgba(14,165,233,${alpha})`; gx.beginPath(); gx.moveTo(p[0],p[1]); gx.lineTo(q[0],q[1]); gx.stroke();
    }
    for (const n of G.nodes) {
      const [x,y] = w2s(n); const m = matchNode(n);
      let a = m ? (RM ? 0.85 : 0.55 + 0.35 * Math.sin(TT * 1.3 + n.ph)) : 0.12;
      let rr = 2.8 * Math.min(1.6, Math.max(.8, cam.k));
      if (act) { if (nb.has(n)) a = 1; else a *= .25; }
      if (n === act) { rr *= 2; gx.fillStyle = 'rgba(14,165,233,.18)'; gx.beginPath(); gx.arc(x,y,rr*3,0,Math.PI*2); gx.fill(); }
      gx.fillStyle = `rgba(3,105,161,${a})`; gx.beginPath(); gx.arc(x,y,rr,0,Math.PI*2); gx.fill();
      if (n === sel) { gx.strokeStyle = '#0ea5e9'; gx.lineWidth = 1.5; gx.beginPath(); gx.arc(x,y,rr+6,0,Math.PI*2); gx.stroke(); gx.lineWidth = 1; }
      if (cam.k > 1.6 && m) { gx.fillStyle = `rgba(15,23,42,${0.7*a})`; gx.font = '11px sans-serif'; gx.fillText(n.p.name, x+rr+6, y+4); }
    }
  }
  function gloop(ts: number) { raf = 0; if (lvOn) return; if (!RM || dirty) { TT = RM ? 0 : ts/1000; gdraw(); dirty = false; } raf = requestAnimationFrame(gloop); }

  function chips() {
    const el = $('#chips'); if (!el || !G) return;
    el.innerHTML = ['All', ...G.teams].map(t => `<button class="chip" aria-pressed="${t === 'All' ? !ft : t === ft}" data-t="${esc(t)}">${esc(t)}</button>`).join('');
  }
  function listViewRender() {
    const el = $('#gl'); if (!el || !G) return;
    el.innerHTML = G.nodes.filter(matchNode).map((n: any) => `<li><button data-i="${n.i}">${esc(n.p.name)}<span>${esc(n.p.role)} · ${esc(n.p.team)}</span></button></li>`).join('');
  }
  function openCard(n: any) {
    sel = n; const p = n.p; const c = $('#gcard'); if (!c) return;
    c.hidden = false;
    const img = publicUrl(p.image_path);
    c.innerHTML = `<div class="ph4" style="aspect-ratio:4/5">${img ? `<img src="${esc(img)}" alt="${esc(p.name)}">` : `<b aria-hidden="true" style="font-size:32px">${esc(ini(p.name))}</b>`}</div>
      <div><h3>${esc(p.name)}</h3><span class="lbl">${esc(p.role)}</span><br><span class="lbl">${esc(p.team)}</span>${p.link ? `<br><a class="lk" href="${esc(p.link)}" rel="noopener">Profile</a>` : ''}</div>
      <button class="sm" data-x style="grid-column:1/-1;justify-self:end">Close</button>`;
    dirty = true;
  }
  function closeCard() { sel = null; const c = $('#gcard'); if (c) c.hidden = true; dirty = true; }
  (window as any).__closeCard = closeCard;

  function startGraph() {
    G = buildGraph(contributors);
    hv = null; sel = null; closeCard();
    ($('#cn') as HTMLElement).textContent = contributors.length + ' contributors';
    chips(); listViewRender(); gsize();
    const R = Math.max(...G.nodes.map((n: any) => Math.hypot(n.x, n.y)), 1);
    const w = G.w || 600, h = G.h || 400;
    cam = { x: 0, y: 0, k: Math.min(w, h) / (2.3 * R) };
    dirty = true; if (!raf) raf = requestAnimationFrame(gloop);
  }

  const pick = (mx: number, my: number) => { let b: any = null, bd = 196; for (const n of G.nodes) { const [x,y] = w2s(n); const d = (x-mx)**2 + (y-my)**2; if (d < bd) { bd = d; b = n; } } return b; };
  function zoom(f: number, sx: number, sy: number) { const k = Math.min(6, Math.max(.4, cam.k*f)), g = k/cam.k, cx = sx - G.w/2, cy = sy - G.h/2; cam.x = cx - (cx - cam.x)*g; cam.y = cy - (cy - cam.y)*g; cam.k = k; dirty = true; }

  const P = new Map<number, {x:number,y:number}>(); let drag: any = null, pinch = 0;
  cvs.addEventListener('pointerdown', (e) => { cvs.setPointerCapture(e.pointerId); const r = cvs.getBoundingClientRect(); P.set(e.pointerId, { x: e.clientX-r.left, y: e.clientY-r.top }); drag = { sx: e.clientX, sy: e.clientY, m: false }; if (P.size === 2) { const [a,b] = [...P.values()]; pinch = Math.hypot(a.x-b.x, a.y-b.y); } });
  cvs.addEventListener('pointermove', (e) => { if (!G) return; const r = cvs.getBoundingClientRect(); const x = e.clientX-r.left, y = e.clientY-r.top; const o = P.get(e.pointerId); if (o) { P.set(e.pointerId, {x,y}); if (P.size === 2) { const [a,b] = [...P.values()]; const d = Math.hypot(a.x-b.x, a.y-b.y); if (pinch) zoom(d/pinch, (a.x+b.x)/2, (a.y+b.y)/2); pinch = d; drag.m = true; } else { cam.x += x-o.x; cam.y += y-o.y; if (Math.hypot(e.clientX-drag.sx, e.clientY-drag.sy) > 4) drag.m = true; } } else { hv = pick(x,y); cvs.style.cursor = hv ? 'pointer' : 'grab'; } dirty = true; });
  cvs.addEventListener('pointerup', (e) => { if (P.size === 1 && drag && !drag.m) { const r = cvs.getBoundingClientRect(); const n = pick(e.clientX-r.left, e.clientY-r.top); n ? openCard(n) : closeCard(); } P.delete(e.pointerId); pinch = 0; dirty = true; });
  cvs.addEventListener('pointerleave', () => { hv = null; dirty = true; });
  cvs.addEventListener('wheel', (e) => { e.preventDefault(); const r = cvs.getBoundingClientRect(); zoom(Math.exp(-e.deltaY*.0015), e.clientX-r.left, e.clientY-r.top); }, { passive: false });

  $('#chips')?.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('[data-t]') as HTMLElement | null; if (!b) return; const t = b.dataset.t || 'All'; ft = t === 'All' ? '' : t; chips(); listViewRender(); dirty = true; });
  ($('#q') as HTMLInputElement | null)?.addEventListener('input', (e) => { fq = (e.target as HTMLInputElement).value.trim().toLowerCase(); listViewRender(); dirty = true; });
  $('#lv')?.addEventListener('click', (e) => { lvOn = !lvOn; const btn = e.currentTarget as HTMLButtonElement; btn.setAttribute('aria-pressed', String(lvOn)); btn.textContent = lvOn ? 'Graph view' : 'List view'; ($('#gl') as HTMLElement).hidden = !lvOn; ($('#gw') as HTMLElement).hidden = lvOn; if (!lvOn) { gsize(); if (!raf) raf = requestAnimationFrame(gloop); } });
  $('#gl')?.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('[data-i]') as HTMLElement | null; if (b && G) openCard(G.nodes[+b.dataset.i!]); });
  $('#gcard')?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-x]')) closeCard(); });
  addEventListener('resize', () => { if (G && !lvOn) gsize(); });

  async function load() {
    try {
      if (supabase) {
        const { data } = await supabase.from('contributors').select('*').order('sort_order', { ascending: true });
        if (data && data.length) contributors = data as any;
      }
    } catch {}
    startGraph();
  }

  load();
</script>
