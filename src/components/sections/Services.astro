---
import { C } from '../../lib/content';
const words = (t: string) => t.split(' ').map((w) => `<span class="w">${w.replace(/[&<>"]/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c] as string))}</span>`).join(' ');
---
<section class="wrap" id="svc">
  <hr class="hl" />
  <div style="padding-top:32px">
    <div class="lbl">{C.sol.label}</div>
    <h2 class="big" set:html={words(C.sol.text)}></h2>
    <div class="lbl" style="margin-top:56px">{C.sol.over}</div>
    <ol class="svc" id="sv">
      {C.sol.list.map((s, i) => <li><span>{`0${i + 1}`}</span>{s}</li>)}
    </ol>
  </div>
</section>
